{
  "manifest_version": 3,
  "name": "PhishNet Auto Scanner",
  "version": "2.0",
  "description": "Scans every page you open and blocks high-risk sites.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "action": { "default_popup": "popup.html", "default_title": "PhishNet" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
